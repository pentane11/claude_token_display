{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token_display",
  "version": "0.2.0",
  "identifier": "com.pentane11.tokendisplay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "Claude Token Usage",
        "url": "index.html",
        "width": 340,
        "height": 420,
        "minWidth": 220,
        "minHeight": 260,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
